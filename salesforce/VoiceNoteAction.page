<!--
  SALESFORCE VISUALFORCE QUICK ACTION — Voice Note
  ================================================
  DEPLOYMENT STEPS (takes ~5 minutes, no CLI needed):

  1. In Salesforce: Setup → Developer Console → File → New → Visualforce Page
     Name: VoiceNoteAction  (exactly this, no spaces)
     Paste ALL of this file's contents → Save

  2. Setup → Object Manager → Lead → Buttons, Links, and Actions → New Action
     - Action Type:      Visualforce Page
     - Visualforce Page: VoiceNoteAction
     - Label:            Voice Note
     - Name:             Voice_Note
     - Height:           560 (pixels)
     → Save

  3. Setup → Object Manager → Lead → Page Layouts → Lead Layout
     - Click "Mobile & Lightning Actions" in the palette
     - Drag "Voice Note" into the Salesforce Mobile and Lightning Experience Actions bar
     → Save

  Done. Reps see a "Voice Note" button on every Lead. Clicking it opens a modal
  that already knows the Lead ID and who they are — no manual entry needed.

  ZAPIER UPDATE NEEDED:
  The payload now includes `lead_id`. Update your Zap:
  - Remove "Find Record" search step
  - In "Update Record" step, set Record ID = {{lead_id}} from the webhook
  The `am_to_make_last_offer` field is now dynamic (comes from Salesforce login).
-->
<apex:page standardController="Lead" showHeader="false" sidebar="false"
           docType="html-5.0" applyBodyTag="false" applyHtmlTag="false"
           cache="false">
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Voice Note</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: #0a0a0f; color: #e8e8f0; font-family: 'Segoe UI', sans-serif; min-height: 100vh; padding-bottom: 60px; overflow-x: hidden; }
  .header { background: #13131a; border-bottom: 1px solid #2a2a3a; padding: 14px 16px 10px; position: sticky; top: 0; z-index: 100; }
  .header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3px; }
  .logo { font-size: 20px; font-weight: 800; letter-spacing: -1px; }
  .logo span { color: #00e5a0; }
  .stage-badge { background: #7b5ea7; color: white; font-size: 10px; padding: 3px 10px; border-radius: 20px; font-family: monospace; }
  .context-bar { font-size: 11px; font-family: monospace; color: #00e5a0; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .section { padding: 16px 16px 0; }
  .section-label { font-family: monospace; font-size: 10px; letter-spacing: 1.5px; color: #6b6b80; text-transform: uppercase; margin-bottom: 8px; }
  .input-field { width: 100%; background: #13131a; border: 1px solid #2a2a3a; border-radius: 10px; padding: 10px 12px; color: #e8e8f0; font-family: monospace; font-size: 12px; outline: none; transition: border-color 0.2s; }
  .input-field:focus { border-color: #00e5a0; }
  .input-field::placeholder { color: #6b6b80; }
  .record-area { background: #13131a; border: 1px solid #2a2a3a; border-radius: 16px; padding: 20px 16px; margin: 0 16px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .record-btn { width: 72px; height: 72px; border-radius: 50%; border: none; background: #00e5a0; cursor: pointer; font-size: 28px; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
  .record-btn.recording { background: #ff4d6d; animation: pulse 1.5s ease infinite; }
  @keyframes pulse { 0%{box-shadow:0 0 0 0 rgba(255,77,109,0.4);}70%{box-shadow:0 0 0 18px rgba(255,77,109,0);}100%{box-shadow:0 0 0 0 rgba(255,77,109,0);} }
  .record-status { font-family: monospace; font-size: 12px; color: #6b6b80; text-align: center; }
  .transcript-box { width: 100%; background: #1c1c28; border: 1px solid #2a2a3a; border-radius: 10px; padding: 10px; font-size: 12px; color: #aaaacc; line-height: 1.6; font-style: italic; display: none; }
  .parse-btn { width: 100%; padding: 12px; background: #00e5a0; color: #0a0a0f; border: none; border-radius: 10px; font-size: 14px; font-weight: 700; cursor: pointer; display: none; }
  .parse-btn:disabled { background: #2a2a3a; color: #6b6b80; cursor: not-allowed; }
  .manual-textarea { width: 100%; background: #1c1c28; border: 1px solid #2a2a3a; border-radius: 10px; padding: 10px; color: #e8e8f0; font-family: 'Segoe UI', sans-serif; font-size: 12px; outline: none; resize: vertical; min-height: 72px; line-height: 1.6; }
  .manual-textarea:focus { border-color: #7b5ea7; }
  .manual-textarea::placeholder { color: #6b6b80; }
  .manual-parse-btn { width: 100%; padding: 10px; background: #7b5ea7; color: white; border: none; border-radius: 10px; font-size: 13px; font-weight: 700; cursor: pointer; display: none; margin-top: 6px; }
  .clear-btn { width: 100%; padding: 11px; background: transparent; color: #6b6b80; border: 1px solid #2a2a3a; border-radius: 12px; font-size: 13px; cursor: pointer; }
  .fields-wrap { display: flex; flex-direction: column; gap: 8px; padding: 0 16px; }
  .field-row { background: #13131a; border: 1px solid #2a2a3a; border-radius: 12px; padding: 10px 12px; transition: border-color 0.2s; }
  .field-row.filled { border-color: #00e5a0; }
  .field-row.missing { border-color: #ff4d6d; }
  .field-row.locked { opacity: 0.5; }
  .field-row.prefilled { border-color: #3a3a4a; }
  .field-name { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; font-family: monospace; font-size: 10px; letter-spacing: 1px; color: #6b6b80; text-transform: uppercase; }
  .req { color: #ff4d6d; font-size: 10px; }
  .opt { color: #6b6b80; font-size: 10px; }
  .lck { background: #2a2a3a; color: #6b6b80; font-size: 9px; padding: 2px 6px; border-radius: 4px; }
  .sf-badge { background: #00e5a0; color: #0a0a0f; font-size: 9px; padding: 2px 6px; border-radius: 4px; font-weight: 700; }
  .fi { width: 100%; background: transparent; border: none; color: #e8e8f0; font-size: 13px; font-family: 'Segoe UI', sans-serif; outline: none; padding: 0; }
  .fi option { background: #1c1c28; }
  .fv { font-size: 12px; color: #6b6b80; font-style: italic; }
  .fv.green { color: #00e5a0; font-style: normal; font-weight: 600; }
  .missing-banner { background: rgba(255,77,109,0.1); border: 1px solid #ff4d6d; border-radius: 10px; padding: 10px 12px; font-size: 12px; color: #ff4d6d; line-height: 1.5; display: none; margin-bottom: 10px; }
  .result-banner { border-radius: 12px; padding: 12px; font-size: 13px; font-weight: 500; text-align: center; display: none; margin-bottom: 10px; }
  .result-banner.success { background: rgba(0,229,160,0.1); border: 1px solid #00e5a0; color: #00e5a0; display: block; }
  .result-banner.error { background: rgba(255,77,109,0.1); border: 1px solid #ff4d6d; color: #ff4d6d; display: block; }
  .save-settings-btn { background: #00e5a0; color: #0a0a0f; border: none; border-radius: 10px; padding: 9px 18px; font-weight: 800; font-size: 12px; cursor: pointer; font-family: monospace; }
  .send-btn { width: 100%; padding: 16px; background: #00e5a0; color: #0a0a0f; border: none; border-radius: 12px; font-size: 16px; font-weight: 800; cursor: pointer; }
  .send-btn:disabled { background: #2a2a3a; color: #6b6b80; cursor: not-allowed; }
  .mic-warn { background: rgba(255,159,28,0.1); border: 1px solid #ff9f1c; border-radius: 10px; padding: 10px 12px; font-size: 11px; color: #ff9f1c; line-height: 1.5; display: none; margin: 0 16px; }
  input[type="date"]::-webkit-calendar-picker-indicator,
  input[type="datetime-local"]::-webkit-calendar-picker-indicator { filter: invert(1); }

</div>

<div style="padding:16px;">
  <div class="missing-banner" id="missingBanner"></div>
  <div class="result-banner" id="resultBanner"></div>
  <button class="send-btn" id="sendBtn" onclick="sendToZapier()" disabled>Send to Salesforce →</button>
</div>

<script>
// ── Salesforce context (injected server-side at render time) ──────────────────
const SF_LEAD_ID     = '{!Lead.Id}';
const SF_REP_NAME    = '{!JSENCODE($User.Name)}';
const SF_LEAD_NAME   = '{!JSENCODE(Lead.Name)}';
const SF_LEAD_PHONE  = '{!JSENCODE(Lead.Phone)}';
const SF_LEAD_STREET = '{!JSENCODE(Lead.Street)}';
const SF_LEAD_CITY   = '{!JSENCODE(Lead.City)}';
const SF_LEAD_STATE  = '{!JSENCODE(Lead.StateCode)}';
const SF_LEAD_ZIP    = '{!JSENCODE(Lead.PostalCode)}';

// ── Constants ────────────────────────────────────────────────────────────────
const REQ = ['opportunity_name','property_address','am_notes','next_step',
  'next_contact_date','last_conversation_date','last_offer','offer_made_time',
  'reason_not_locked','follow_up_status','appointment_set_quality',
  'appointment_attendance','in_person_appointment_completed'];

const LBL = {
  property_address:'Property Address', opportunity_name:'Opportunity Name',
  am_notes:'AM Notes', next_step:'Next Step', next_contact_date:'Next Contact Date',
  last_conversation_date:'Last Conversation Date', last_offer:'Last Offer',
  offer_made_time:'Offer Made Time', reason_not_locked:'Reason Not Locked',
  follow_up_status:'Follow Up Status', appointment_set_quality:'Appt Quality',
  appointment_attendance:'Appt Attendance',
  in_person_appointment_completed:'In Person Completed'
};

let isRec = false, recog = null, tfinal = '';

// ── Utilities ────────────────────────────────────────────────────────────────
function normalizePhone(v) { return v.replace(/\D/g, ''); }
function sanitizeForSOQL(s) { return s ? s.replace(/\s+/g, ' ').trim() : s; }

function todayDate() {
  const d = new Date(), p = n => String(n).padStart(2,'0');
  return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}`;
}
function nowDatetime() {
  const d = new Date(), p = n => String(n).padStart(2,'0');
  return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
}

// ── Field state ──────────────────────────────────────────────────────────────
function uf(k) {
  const el = document.getElementById(k), row = document.getElementById('row-'+k);
  if (!el || !row) return;
  const ok = el.value.trim() !== '';
  row.classList.toggle('filled', ok);
  row.classList.toggle('missing', !ok && REQ.includes(k));
  checkSend();
}

function checkSend() {
  const miss = REQ.filter(k => { const el = document.getElementById(k); return el && el.value.trim() === ''; });
  const bn = document.getElementById('missingBanner'), btn = document.getElementById('sendBtn');
  if (miss.length) {
    bn.style.display = 'block';
    bn.textContent = '⚠️ Missing: ' + miss.map(k => LBL[k]).join(', ');
    btn.disabled = true;
  } else {
    bn.style.display = 'none';
    btn.disabled = false;
  }
}

// ── UI toggles ───────────────────────────────────────────────────────────────
function toggleSettings() {
  const p = document.getElementById('settings-panel'), c = document.getElementById('settings-chevron');
  const v = p.style.display !== 'none';
  p.style.display = v ? 'none' : 'block';
  c.textContent = v ? '▼ show' : '▲ hide';
}

function toggleLocked() {
  const p = document.getElementById('locked-fields'), c = document.getElementById('locked-chevron');
  const v = p.style.display !== 'none';
  p.style.display = v ? 'none' : 'flex';
  c.textContent = v ? '▼ show' : '▲ hide';
}

function onManualInput() {
  const val = document.getElementById('manualNote').value.trim();
  document.getElementById('manualParseBtn').style.display = val ? 'block' : 'none';
}

// ── Voice recording ──────────────────────────────────────────────────────────
function toggleRecord() { if (isRec) stopRec(); else startRec(); }

function startRec() {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) {
    setS('Speech recognition not supported — use Chrome','#ff4d6d');
    document.getElementById('micWarn').style.display = 'block';
    return;
  }
  tfinal = '';
  document.getElementById('transcriptBox').style.display = 'none';
  document.getElementById('transcriptBox').textContent = '';
  document.getElementById('parseBtn').style.display = 'none';
  recog = new SR();
  recog.continuous = true;
  recog.interimResults = true;
  recog.lang = 'en-US';
  recog.onresult = e => {
    let f = '', i = '';
    for (let x = e.resultIndex; x < e.results.length; x++) {
      if (e.results[x].isFinal) f += e.results[x][0].transcript;
      else i += e.results[x][0].transcript;
    }
    tfinal += f;
    const b = document.getElementById('transcriptBox');
    b.textContent = tfinal + i;
    b.style.display = 'block';
  };
  recog.onerror = e => {
    stopRec();
    if (e.error === 'not-allowed' || e.error === 'service-not-allowed') {
      setS('Mic blocked — type your notes below','#ff9f1c');
      document.getElementById('micWarn').style.display = 'block';
    } else {
      setS('Mic error: ' + e.error, '#ff4d6d');
    }
  };
  recog.onend = () => { if (isRec) { recog.start(); } };
  recog.start();
  isRec = true;
  document.getElementById('recordBtn').classList.add('recording');
  document.getElementById('recordBtn').textContent = '⏹️';
  setS('Recording... tap to stop','#ff4d6d');
}

function stopRec() {
  if (recog) { recog.onend = null; recog.stop(); }
  isRec = false;
  document.getElementById('recordBtn').classList.remove('recording');
  document.getElementById('recordBtn').textContent = '🎙️';
  if (tfinal.trim()) {
    setS('Parsing your note...','#ff9f1c');
    parseWithAI('voice');
  } else {
    setS('Tap to record your notes','#6b6b80');
  }
}

function setS(msg, color) {
  const el = document.getElementById('recordStatus');
  el.textContent = msg;
  el.style.color = color || '#6b6b80';
}

// ── AI parsing ───────────────────────────────────────────────────────────────
async function parseWithAI(source) {
  const key = document.getElementById('apiKey').value.trim();
  if (!key) { alert('Enter your Anthropic API key in Settings first.'); return; }
  const text = source === 'manual'
    ? document.getElementById('manualNote').value.trim()
    : tfinal.trim();
  if (!text) return;

  const pb = source === 'manual'
    ? document.getElementById('manualParseBtn')
    : document.getElementById('parseBtn');
  pb.textContent = '⏳ Parsing...';
  pb.disabled = true;
  setS('AI is reading your notes...','#ff9f1c');
  const rb0 = document.getElementById('resultBanner');
  rb0.textContent = ''; rb0.className = 'result-banner';

  const today = new Date().toISOString().split('T')[0];
  const prompt = `Extract info from this real estate wholesaling sales note. Return ONLY a valid JSON object, no explanation, no markdown.

Keys:
- property_address: full property address in format "Street, City, ST, Zip, United States" — always use 2-letter state abbreviation — used as primary Salesforce lookup key
- opportunity_name: seller name or deal name
- seller_phone: seller phone number digits only no dashes or spaces (e.g. 2145158483), empty string if not mentioned
- am_notes: detailed summary of the conversation including seller situation, motivation, property condition
- next_step: next action to take
- next_contact_date: follow-up date (YYYY-MM-DD, today is ${today})
- last_conversation_date: date of this conversation (YYYY-MM-DD, default today)
- last_offer: dollar amount as number only, 0 if unknown
- offer_made_time: when offer was made (YYYY-MM-DDTHH:MM), use today noon if not specified
- reason_not_locked: must be exactly one of: Not Ready, High Price, Other People Involved (infer from context)
- follow_up_status: must be exactly one of: Hot, Cold (Hot = urgent/motivated, Cold = not ready/hesitant)
- appointment_set_quality: must be exactly one of: Good, Bad
- appointment_attendance: must be exactly one of: Everyone Showed Up, AM Rescheduled, Seller didn't Show Up
- in_person_appointment_completed: must be exactly one of: Yes, No

Use empty string "" for unknown text fields.

Note: "${text}"`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': key,
        'anthropic-version': '2023-06-01',
        'anthropic-dangerous-direct-browser-access': 'true'
      },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 1000,
        messages: [{ role: 'user', content: prompt }]
      })
    });
    const data = await res.json();
    if (data.error) throw new Error(data.error.message);
    const raw = data.content.map(i => i.text || '').join('');
    const parsed = JSON.parse(raw.replace(/```json|```/g, '').trim());

    ['seller_phone','property_address','opportunity_name','am_notes','next_step',
     'next_contact_date','last_conversation_date','offer_made_time'].forEach(k => {
      const el = document.getElementById(k);
      if (el && parsed[k]) {
        el.value = k === 'seller_phone' ? normalizePhone(parsed[k]) : parsed[k];
        uf(k);
      }
    });
    ['follow_up_status','appointment_set_quality','appointment_attendance',
     'in_person_appointment_completed','reason_not_locked'].forEach(k => {
      const el = document.getElementById(k);
      if (el && parsed[k]) { el.value = parsed[k]; uf(k); }
    });
    const lo = document.getElementById('last_offer');
    if (lo && parsed.last_offer !== undefined) { lo.value = parsed.last_offer; uf('last_offer'); }

    setS('✅ Fields filled from your note!','#00e5a0');
    pb.textContent = '✨ Re-parse';
  } catch (err) {
    const msg = err.message || '';
    const rb = document.getElementById('resultBanner');
    if (/credit|quota|billing|insufficient|balance/i.test(msg)) {
      rb.textContent = '⚠️ API credits exhausted. Add credits at console.anthropic.com → Billing.';
      rb.className = 'result-banner error';
      setS('❌ Out of API credits','#ff4d6d');
    } else {
      rb.textContent = '❌ AI parse failed: ' + msg;
      rb.className = 'result-banner error';
      setS('❌ Parse failed','#ff4d6d');
    }
    pb.textContent = source === 'manual' ? '✨ Parse typed note with AI' : '🔄 Re-parse';
  }
  pb.disabled = false;
  checkSend();
}

// ── Send to Zapier ───────────────────────────────────────────────────────────
async function sendToZapier() {
  const url = document.getElementById('webhookUrl').value.trim();
  if (!url) { alert('Enter your Zapier webhook URL in Settings first.'); return; }
  const btn = document.getElementById('sendBtn');
  btn.textContent = 'Sending...';
  btn.disabled = true;

  const p = {
    lead_id:                        SF_LEAD_ID,
    seller_phone:                   document.getElementById('seller_phone').value.trim(),
    property_address:               sanitizeForSOQL(document.getElementById('property_address').value.trim()),
    opportunity_name:               sanitizeForSOQL(document.getElementById('opportunity_name').value.trim()),
    am_notes:                       sanitizeForSOQL(document.getElementById('am_notes').value.trim()),
    next_step:                      sanitizeForSOQL(document.getElementById('next_step').value.trim()),
    next_contact_date:              document.getElementById('next_contact_date').value,
    stage:                          'Follow Up',
    follow_up_status:               document.getElementById('follow_up_status').value,
    last_conversation_date:         document.getElementById('last_conversation_date').value,
    am_to_make_last_offer:          SF_REP_NAME,
    last_offer:                     parseFloat(document.getElementById('last_offer').value) || 0,
    offer_made_time:                document.getElementById('offer_made_time').value,
    reason_not_locked:              document.getElementById('reason_not_locked').value,
    google_drive_link:              'placeholder',
    appointment_set_quality:        document.getElementById('appointment_set_quality').value,
    appointment_attendance:         document.getElementById('appointment_attendance').value,
    in_person_appointment_completed: document.getElementById('in_person_appointment_completed').value,
    survey_call_setup:              document.getElementById('survey_call_setup').checked ? 'Yes' : 'No',
    survey_call_assigned_to:        'Marcus Daniel'
  };

  const rb = document.getElementById('resultBanner');
  try {
    await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(p),
      mode: 'no-cors'
    });
    rb.textContent = '✅ Sent! Clearing in 4 seconds...';
    rb.className = 'result-banner success';
    btn.textContent = '✅ Sent!';
    setTimeout(() => {
      clearAll();
      btn.textContent = 'Send to Salesforce →';
      rb.textContent = '';
      rb.className = 'result-banner';
    }, 4000);
  } catch (e) {
    rb.textContent = '❌ Failed to send. Check your webhook URL in Settings.';
    rb.className = 'result-banner error';
    btn.textContent = 'Send to Salesforce →';
    btn.disabled = false;
  }
}

// ── Drive prep ───────────────────────────────────────────────────────────────
async function createDrivePrep() {
  const url = localStorage.getItem('sf_drive_prep_url') || '';
  if (!url) { alert('Enter your Drive Prep Webhook URL in Settings first.'); return; }
  const address = document.getElementById('property_address').value.trim();
  const name    = document.getElementById('opportunity_name').value.trim();
  const apptRaw = document.getElementById('next_contact_date').value;
  if (!address) { alert('Enter Property Address first.'); return; }
  const apptDate = apptRaw ? new Date(apptRaw + 'T12:00:00') : null;
  const monthLabel = apptDate ? apptDate.toLocaleString('en-US', { month: 'long' }) + ' ' + apptDate.getFullYear() : '';
  const btn = document.getElementById('prepBtn');
  const res = document.getElementById('prepResult');
  btn.textContent = 'Sending...'; btn.disabled = true; res.textContent = '';
  try {
    await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        property_address: address, opportunity_name: name,
        appointment_date: apptRaw, month_label: monthLabel,
        year: apptDate ? String(apptDate.getFullYear()) : ''
      }),
      mode: 'no-cors'
    });
    res.textContent = '✅ Sent — Zapier is creating your Drive folder + sheet.';
  } catch (e) {
    res.textContent = '❌ Failed. Check your Drive Prep Webhook URL.';
  }
  btn.textContent = '📁 Create Folder + Sheet'; btn.disabled = false;
}

// ── Clear all ────────────────────────────────────────────────────────────────
function clearAll() {
  const allFields = [...REQ, 'seller_phone'];
  allFields.forEach(k => {
    const el = document.getElementById(k);
    if (el) el.value = '';
    const r = document.getElementById('row-' + k);
    if (r) r.classList.remove('filled','missing');
  });
  document.getElementById('survey_call_setup').checked = true;
  document.getElementById('transcriptBox').style.display = 'none';
  document.getElementById('transcriptBox').textContent = '';
  document.getElementById('parseBtn').style.display = 'none';
  document.getElementById('manualNote').value = '';
  document.getElementById('manualParseBtn').style.display = 'none';
  document.getElementById('resultBanner').className = 'result-banner';
  document.getElementById('missingBanner').style.display = 'none';
  setS('Tap to record your notes','#6b6b80');
  tfinal = '';
  initSFContext();
  setDateDefaults();
  checkSend();
}

// ── Settings persistence ─────────────────────────────────────────────────────
function saveKey() {
  const v = document.getElementById('apiKey').value.trim();
  if (v) localStorage.setItem('sf_api_key', v); else localStorage.removeItem('sf_api_key');
}
function saveSettings() {
  const hook = document.getElementById('webhookUrl').value.trim();
  const driveHook = document.getElementById('drivePrepUrl').value.trim();
  if (hook) localStorage.setItem('sf_webhook_url', hook); else localStorage.removeItem('sf_webhook_url');
  if (driveHook) localStorage.setItem('sf_drive_prep_url', driveHook); else localStorage.removeItem('sf_drive_prep_url');
  const el = document.getElementById('saveConfirm');
  el.style.display = 'inline';
  setTimeout(() => { el.style.display = 'none'; }, 2500);
}

// ── SF context init ──────────────────────────────────────────────────────────
function initSFContext() {
  // Context bar
  const leadLabel = SF_LEAD_NAME || 'Unknown Lead';
  const repLabel  = SF_REP_NAME  || 'Unknown Rep';
  document.getElementById('contextBar').textContent =
    '⚡ Lead: ' + leadLabel + '  ·  Rep: ' + repLabel;

  // Rep display in locked fields
  document.getElementById('rep-display').textContent = repLabel;

  // Pre-fill from SF Lead data
  const nameEl = document.getElementById('opportunity_name');
  if (nameEl && !nameEl.value && SF_LEAD_NAME) { nameEl.value = SF_LEAD_NAME; uf('opportunity_name'); }

  const phoneEl = document.getElementById('seller_phone');
  if (phoneEl && !phoneEl.value && SF_LEAD_PHONE) {
    phoneEl.value = normalizePhone(SF_LEAD_PHONE); uf('seller_phone');
  }

  const addrEl = document.getElementById('property_address');
  if (addrEl && !addrEl.value) {
    const parts = [SF_LEAD_STREET, SF_LEAD_CITY, SF_LEAD_STATE, SF_LEAD_ZIP, 'United States']
      .filter(s => s && s.trim());
    if (parts.length > 1) { addrEl.value = parts.join(', '); uf('property_address'); }
  }
}

function setDateDefaults() {
  const lcd = document.getElementById('last_conversation_date');
  const omt = document.getElementById('offer_made_time');
  if (lcd && !lcd.value) { lcd.value = todayDate(); uf('last_conversation_date'); }
  if (omt && !omt.value) { omt.value = nowDatetime(); uf('offer_made_time'); }
}

// ── Init ─────────────────────────────────────────────────────────────────────
(function init() {
  // Load saved credentials
  const key      = localStorage.getItem('sf_api_key');
  const hook     = localStorage.getItem('sf_webhook_url');
  const driveHook = localStorage.getItem('sf_drive_prep_url');
  if (key)       document.getElementById('apiKey').value = key;
  if (hook)      document.getElementById('webhookUrl').value = hook;
  if (driveHook) document.getElementById('drivePrepUrl').value = driveHook;

  initSFContext();
  setDateDefaults();
  checkSend();
})();
</script>

    <span style="font-family:monospace;font-size:10px;letter-spacing:1px;color:#6b6b80;text-transform:uppercase;">Auto / Locked Fields</span>
    <span id="locked-chevron" style="color:#6b6b80;font-size:12px;">▼ show</span>
  </div>
  <div id="locked-fields" style="display:none;flex-direction:column;gap:8px;">
    <div class="field-row filled locked">
      <div class="field-name">Survey Call Setup <span class="lck">auto</span></div>
      <div style="display:flex;align-items:center;gap:10px;margin-top:4px;">
        <input type="checkbox" id="survey_call_setup" checked style="width:16px;height:16px;accent-color:#00e5a0;" />
        <span style="font-size:12px;color:#6b6b80;">Checked = Yes</span>
      </div>
    </div>
    <div class="field-row locked"><div class="field-name">Stage <span class="lck">locked</span></div><div class="fv">Follow Up</div></div>
    <div class="field-row locked">
      <div class="field-name">AM to Make Last Offer <span class="sf-badge">from SF</span></div>
      <div class="fv green" id="rep-display">—</div>
    </div>
    <div class="field-row locked"><div class="field-name">Survey Call Assigned To <span class="lck">locked</span></div><div class="fv">Marcus Daniel</div></div>
    <div class="field-row locked"><div class="field-name">Google Drive Link <span class="lck">locked</span></div><div class="fv">placeholder</div></div>

<div class="header">
  <div class="header-top">
    <div class="logo">SF<span>Voice</span></div>
    <div class="stage-badge">FOLLOW UP</div>
  </div>
  <div class="context-bar" id="contextBar">Loading lead context...</div>
</div>

<!-- Settings (collapsible) -->
<div id="settings-toggle" onclick="toggleSettings()" style="cursor:pointer;background:#13131a;border-bottom:1px solid #2a2a3a;padding:10px 16px;display:flex;justify-content:space-between;align-items:center;">
